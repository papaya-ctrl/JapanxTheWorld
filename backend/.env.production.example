# Store the real file outside Git, owned by the service account/root, mode 0600.
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.example.invalid
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.invalid,https://api.example.invalid
DJANGO_TRUSTED_PROXY_IPS=127.0.0.1,::1
DJANGO_STATE_DIR=/var/lib/japanxtheworld
DJANGO_STATIC_ROOT=/srv/japanxtheworld-static
DOCUMENT_OCR_MODEL_ROOT=/var/lib/japanxtheworld/models
# Enable only after verifying HTTPS on EVERY relevant subdomain; leave preload
# off until its separate long-lived requirements and operational impact are accepted.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
